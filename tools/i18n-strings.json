8fd965ee86d6960a96fe45d0d24dd880e87320fcb","s":"הסרט שאנחנו הכי אוהבים להראות. שווה אוזניות."},{"h":"a45448be7656dd6f1637f2723f451af315a007e8f8768608ee9978bc42d85038","s":"מה מצלם אתכם"},{"h":"04ff12759245fdb290c03301bcf9e707f2b67607999d90b9c3ff00742e6f9e5c","s":"גוף פול־פריים, עדשות פריים מהירות, ותאורה שמכבדת את האור שיש בחדר. בלי פלאשים שמסמאים את האורחים."},{"h":"99c28cbeb2b0753c89d81f72a122907eb63f69750b9756e89d39e0b207ac6e3d","s":"סובבו את הדגם — זה הכלי שמלווה אותנו מהבוקר של ההכנות ועד השיר האחרון."},{"h":"efe084615e8d37ea2cdee7ed27882763365a09cf75c95f552e7aec760371ac7d","s":"המצלמה שלנו בתלת־ממד — לתצוגה מלאה ←"},{"h":"46d3eaad713f52a6c48ef5bd0116836ce69988af811264d99b9d20b9730588c5","s":"איך זה עובד"},{"h":"c5aae87c383fb9edcf9d8825a02164ca5647224fbfd047d319b26ae44213dfeb","s":"שיחת היכרות"},{"h":"d4b68c682e023b193eced66c97a9982fc70be1f24b46010863106f3c73e93fbd","s":"20 דקות בטלפון או קפה. מבינים מה חשוב לכם ומה הלוק שאתם מחפשים."},{"h":"8af8d4110e02ad3ee5ae18196ff5bce99795eb9501423a1ae505b2f12a63c609","s":"תכנון האירוע"},{"h":"0af69bcca9ba79900688ff69f4d820c2b6b53c84e12caa8711a5f2e4b8a066b0","s":"לוח זמנים, לוקיישנים, רגעים שאסור לפספס. עוברים על הכול מראש."},{"h":"e1260d5490b569a7ee620627e846f622eb49e08b60dc1bc6f02c48ef222e7226","s":"יום הצילומים"},{"h":"bf8ec8c6baaa6b3e1c2d3aceaf57ba809895e7b042c71bd4608fdb7b9188fe20","s":"אנחנו שם מההכנות ועד הסוף. אתם לא צריכים לחשוב עלינו אפילו לרגע."},{"h":"3c10e1d5be62d6139b1fc122fd8200a9f7c77823bfa93d26e6c48e5d2b83c71a","s":"האלבום והסרט"},{"h":"a11bc492c6f94dc2b43f47383b9c665f5a082953ba455df50b18b8bff94a19b5","s":"תוך 30 יום: הגלריה המלאה והסרט. האלבום המודפס — שבועיים אחרי שאתם מאשרים את הבחירה. אצלכם, לתמיד."},{"h":"2beb8f192a51390c77b697a4f2340ed96245056eee6aea3e69c871f27856c9d1","s":"מה אומרים עלינו"},{"h":"ebcdf24599ddc2c74227f7e99fe1e6836b68d3e6da3bc32e16db32ec1af7d0b0","s":"״קיבלנו את הסרט וישבנו לבכות על הספה. הם היו שם בכל רגע ולא הרגשנו אותם אפילו פעם אחת.״"},{"h":"0442bfa54590e8b63ba7e230cffb73e5501681acfd797f70e80f8a0b6578599f","s":"נועה ואיתי"},{"h":"5cb04d4c3e7c9271cf26019f14287577c187d7075c2c5be798b1454f832dbeac","s":"מאי 2025 · כפר הירוק"},{"h":"6d1e5b6d764764c9a63a30398c937106e2256432530d92e04999006588298c23","s":"״אמא שלי עוד מראה את האלבום לכל מי שנכנס הביתה. זה אומר הכול.״"},{"h":"6fad367a46f085758aaac777991f46016822f5186a7ec8e0eac77a5967377c2f","s":"שירה ודניאל"},{"h":"c04ca76761e65636b3a73c23ea325890e037c36294c6829cd441ee6880c3467f","s":"אוגוסט 2025 · חוות רונית"},{"h":"307db0bccbd8e9969f20a1ba99e6704187fb0e8ea8ef77dff45ac72e03ee809b","s":"״בחרנו אותם מהאינסטגרם בגלל הלוק, וקיבלנו גם אנשים שאפשר לסמוך עליהם בעיניים עצומות.״"},{"h":"95f200071c660162a33f8ac2180290a8df8ed6fe64463a9688fe19b0eac83123","s":"מאיה ויונתן"},{"h":"e1e329b8d465b1b1b754fea61ee67001dc7672d28de2c096862e7adc1424a9a6","s":"נובמבר 2025 · יפו"},{"h":"df1ad70d44cacc9be5c9ab20b45c6fa7db8cd65915e0fc522f9a9fb84364e211","s":"שאלות שנשאלנו כבר"},{"h":"c97844bf4e5a21f29f9e81be85d98c90cc14ff96ada21932c75dace6ae937642","s":"כמה זמן עד שנקבל את החומרים?"},{"h":"09c91ab697db7136eca32025d4e2e1cbde707fe39d565321a58f2d7d4b7b6f75","s":"גלריית תמונות ראשונה תוך 7 ימים, הגלריה המלאה והסרט תוך 30 יום מהאירוע. אלבום מודפס עוד שבועיים אחרי שאתם מאשרים את הבחירה."},{"h":"42790c45d5a3c0f0cf025968920b216cedf88289e5a618ef8836a643534a7e8d","s":"אתם מגיעים לכל הארץ?"},{"h":"10151dbc9c16a4a4f7d8768e236cd0054b7504360ab90a75dbb820686c0b7953","s":"כן. Amora Studio מבוססים בתל אביב, ומצלמים מהגליל ועד אילת — בלי תוספת נסיעות באזור המרכז."},{"h":"b80a19a4ab7b3522eb073b40ddb1bb9f3c5d2431e36494f5bd2318acc7bbad87","s":"יש צלם שני?"},{"h":"2929769b910483f9137a26f357bbd5e578c01341eb7d93696f9aeddeea8608fb","s":"בחתונה מלאה יש תמיד שני צלמים. אחד על הסטילס ואחד על הווידאו, ובחופה ובריקודים שניהם על הזוג משתי זוויות."},{"h":"b5b2095418df99165178e98aa3aec01a029c58be12542c2c623292d53257382c","s":"מה כוללת חבילת החתונה המלאה?"},{"h":"15469f95ad28c7e718db81c2852e811db69cd3c986c7ffb40e9469f24ea3b133","s":"כיסוי מלא של היום, סטילס ווידאו, עריכת צבע לכל תמונה נבחרת, גלריה דיגיטלית לשיתוף, סרט חתונה של 3–5 דקות, טיזר קצר לאינסטגרם ומגנטים עם סורק AR שהופך כל תמונה לסרטון. אלבום מודפס וצילומי Save the Date אפשר להוסיף."},{"h":"afb6daef46b19aa05020f009ef7a56cc19289c8586762a33df3a5249be72fb4d","s":"מה המחיר?"},{"h":"6e70898e90b1b803eb77a4a8a92f247ea6482bf64e105aa29c42e114f2a56188","s":"כל חתונה נבנית אחרת — מספר שעות, מספר צלמים, לוקיישנים. השאירו פרטים ונשמח לשלוח הצעה מותאמת עוד באותו יום."},{"h":"697d35f133369d9c8687f612e2e9b387f8987a4f51df89492ead9a3479c65b60","s":"אפשר לראות אלבום שלם של חתונה?"},{"h":"8b384caf5cb12f06cae71e4a6013b57be04b501113de07c82e5359b032555385","s":"בשמחה. בשיחה נשלח לכם 2–3 גלריות מלאות של חתונות דומות לשלכם, מהבוקר ועד הסוף — לא רק את הפריים המושלם."},{"h":"674d959a5e729f5f5dd58a3417326b68dfbfad16590a5d60dc5adfaaa29e5b66","s":"ומה אם התאריך זז?"},{"h":"f7bda72a67e3cf02dc2835c29ce92bc14862c1d53011c8d1c39d819d821e7a01","s":"התאריך עובר איתכם ללא עלות, בכפוף לזמינות. אם אנחנו תפוסים בתאריך החדש — נחזיר את המקדמה במלואה."},{"h":"49f82cf88e1e307e211348aca5564693aa8fb47f6964a63ec876e802bd0009c3","s":"האולם שלנו חשוך — איך זה מצטלם?"},{"h":"f566fd095e0fde32855e594794721172c964e2f94d43134c714033a5539561eb","s":"אנחנו מצלמים על גוף פול־פריים ועדשות פריים מהירות, כאלה שאוספות הרבה אור, ומשלימים בתאורה שמכבדת את האור שכבר יש בחדר. בלי פלאשים שמסמאים את האורחים."},{"h":"d3b00f638d10a68b84ef17a463c91f87da71d9bf8ac959fdd2cb8aed46582889","s":"מה בדיוק משפיע על מחיר צילום חתונה ←"},{"h":"3f0dfd2b08823f76c8f9d746961dcdb8888ef700fe097421c2a644cda2984c0b","s":"המגנטים שלנו, ואיך הם מתעוררים לחיים — Regaflash ←"},{"h":"be1280a03f08ca189f1892ed2e20f5f774f6253f9a4ff09358e03325e572b132","s":"התאריך שלכם עדיין פנוי?"},{"h":"1d481507ecadb100aed4d84e024f4cbfa2e817367d6eb2a2bb447889f809f60c","s":"השאירו פרטים ונחזור אליכם היום עם זמינות והצעה מותאמת."},{"h":"e56d15c5e409a1f61383e8aaa0a08a1e2bc13e5b4dce094c167c9726e5a83dd3","s":"שם מלא"},{"h":"88997e9b1817e15df10d043e3583f28b07af39b789705d706a3f4