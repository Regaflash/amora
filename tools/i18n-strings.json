1b551c77140655499d481924a2d8482383de82e6a7d3f94419172a8a1","s":"יש שאלה?"},{"h":"69d865911a0ad6e728ea7650c9a3d486501d595b5690850c78507c4a082cddf3","s":"שאלות נפוצות"},{"h":"be37ba580b29bacff78c1173eac17ed97c85ef26fb99a9eaf9cea55d10a124f1","s":"לבדיקת זמינות"},{"h":"20bfaf6c6f3037e659036c6a04ed0fd8cf0caf910456934506c9e351e503c1d3","s":"מה משפיע על מחיר צילום חתונה"},{"h":"eab707c97c5b1bc3426e9a405ed5a477d18bd0138bc507526fd957a42d2d063d","s":"הסבר קצר וכן. אין כאן מחירון — יש כאן מה שמזיז את המספר, כדי שתדעו מה אתם משווים."},{"h":"a3c9f4454fc5d221c5361a4ccace31fdc404d4bd734b86e33893ce3f99aeb7ad","s":"אם הגעתם לכאן אחרי שחיפשתם כמה עולה צלם חתונות, כנראה כבר גיליתם שכמעט אף אחד לא נוקב במספר. זה לא תרגיל שיווקי. פשוט אין מחיר אחד: חתונה של 150 איש בגן אירועים בחמש אחר הצהריים וחתונה של 400 איש עם הכנות משתי דירות והופעה עד שתיים בלילה הן שתי עבודות שונות לגמרי."},{"h":"cdd55a004d5ef1a6748ae92a48629779c228109157408927692316a00102785b","s":"מה שכן אפשר לעשות זה להגיד לכם בדיוק"},{"h":"0c49ca82c1d2c892a74a1fe3fc1960938373ee7ba195baa3a34ecd6bd35c0606","s":"מה מרכיב את ההצעה"},{"h":"929f3921400ef8c3a66567d72814ef4a33990b4f98a627437c712dd6c1f4b27e","s":", כדי שכשתקבלו הצעות משלושה סטודיו תדעו מה אתם משווים."},{"h":"a90ab82daf7e7999d107e00c341ff2d4c681e435bafa1385911c45cb8dbfc067","s":"שלושת הדברים שמזיזים את המחיר"},{"h":"ee3bd1037f73d2a8c5e7505e994c51ece0b154bf1f8541f1667300d81d4fe66b","s":"מספר השעות"},{"h":"7af4e8c30cacc19941e63c4a1a81c3913ad6ee7f209380e15e2c62d2cbca4e0b","s":"ההבדל בין להתחיל בהכנות בבוקר לבין להגיע שעה לפני החופה הוא ההבדל הגדול ביותר בהצעה. זה לא רק זמן הצילום עצמו — כל שעה בשטח מוסיפה גם שעות עריכה אחריה."},{"h":"a4b865244d29e41788b3e6c07951af57f25c37a29cb35b816f4da5017a7c6aed","s":"מספר הצלמים"},{"h":"9a4162bfb2d1305a7d273899a603c389086d29309c9a9b6b27b98230b3c561a8","s":"בחתונה מלאה אצלנו יש תמיד שני צלמים: אחד על הסטילס ואחד על הווידאו. בחופה ובריקודים שניהם על הזוג משתי זוויות. זה לא שדרוג שמוכרים לכם בהמשך — זו ברירת המחדל, ולכן היא כבר בתוך המספר."},{"h":"5607a2412b2e0e0516c4dde5ea655c45f7bde525df61ac1e01dbc64d002047c7","s":"לוקיישנים"},{"h":"09eff284636fb72ced961fa21fdccec0537bb8c183c03ba32f61da3a9d0dd4fd","s":"הכנות בשני מקומות שונים, צילומי זוג בלוקיישן נפרד לפני האולם, מעבר בין אתרים — כל אחד מהם מוסיף זמן, נסיעה ולוגיסטיקה."},{"h":"bc0b285488bbfb432fa19fe3643a54c3ed3f4b056808ac30a81758148680c251","s":"מה כלול אצלנו בחתונה מלאה"},{"h":"aae27e78f13c1cedecfc9579259142a449f9b206886bd69e1ed1b6b05c3381a8","s":"כדי שיהיה ברור מה נמצא בבסיס ולא נמכר בנפרד:"},{"h":"2ed15e9fead42862ac97be369f6186513bb09db9368e5d89254f2c69c27b58ca","s":"כיסוי מלא של היום, סטילס ווידאו"},{"h":"e5fbb4254973528384e6b2720e6f9ead8c0a6deed41effe908114e54f780459a","s":"שני צלמים"},{"h":"e48dd786d8c425f3c0bbc03f9fec3f6402d578a0df5134f44d9282fd9b816d98","s":"עריכת צבע לכל תמונה נבחרת"},{"h":"fa2d52da10804258e5d5ceea0e87a356652c42744780232d900e29c749261431","s":"גלריה דיגיטלית לשיתוף"},{"h":"c0befe346d9bec575a6f0e6e4b96216c1ed3295790a7917036bd28fd5a56fb31","s":"סרט חתונה של 3–5 דקות"},{"h":"462e1de3d4a082c37b63133721294de4b4640fcef35ce77c8308f29f2a45477e","s":"טיזר קצר לאינסטגרם"},{"h":"cbccd82bca0acb769c443591075279db43df42fe13d48e02076f2494b9fb9e28","s":"מגנטים עם סורק AR שהופך כל תמונה לסרטון"},{"h":"25a0debcfc29d34a55c61ed04b0bda6f8f1ba6b026de68c5914ba7a7c66018a9","s":"מה אפשר להוסיף"},{"h":"e2b5d02d31e4cab3fad37d2036624bfd487efc01cb72a63350d6f98f77c05a79","s":"אלבום מודפס, וצילומי Save the Date — שעה וחצי בלוקיישן שאתם אוהבים, לפני היום הגדול. שניהם תוספות, לא חלק מהבסיס."},{"h":"3a0c9b49755be91ff85bba449d7cfecd98095b53b638c0b6b63f85b809e08092","s":"מה לא מוסיף לכם לחשבון"},{"h":"3e60fa940027d9b26fa83db6f4ce64af59ddbc0df449b107d0cca7334df2a276","s":"נסיעות באזור המרכז."},{"h":"65f07fe2dcdd160635a25cb04aa7591eb73454982af5dd55da9e69982a97b731","s":"אנחנו מבוססים בתל אביב ומצלמים מהגליל ועד אילת, בלי תוספת נסיעות באזור המרכז."},{"h":"bdaa8a14307c7a8c295ab2de7fb5d8c9194d14e4ec0912397bd7a9ac3f466286","s":"דחיית תאריך."},{"h":"87ad51f4794775a9ca817acb192dd7e3a63695634419ed952371763cc8d3f7c8","s":"התאריך עובר איתכם ללא עלות, בכפוף לזמינות. אם אנחנו תפוסים בתאריך החדש — מחזירים את המקדמה במלואה."},{"h":"a23909e69477574ab714fb5c709f1987526815336fecf7af67861f218e54eac2","s":"שאלה טובה לשאול כל סטודיו"},{"h":"d40eebad118b4ec0cfcef6f1c073ef81102a799b005ed39e9dd2e1f28402cdca","s":"לא רק אותנו:"},{"h":"e9183f0f583965ee7d9d812e6be2910de74e1a61b0ebfcd73771459943391a17","s":"בקשו לראות אלבום שלם של חתונה אחת"},{"h":"5836864d5a0c1682bb6d688b9e9564d7a255d6dcf80ea2e32efe730ed06ec0c9","s":", מהבוקר ועד הסוף — לא רק את הפריים המושלם מכל אירוע. זה מה שמראה אם מישהו עקבי או שהיה לו מזל. אצלנו, בשיחה, שולחים 2–3 גלריות מלאות של חתונות דומות לשלכם."},{"h":"4dd211742facdafea00c40539ddcc84e97c8c0eab1df439748520b66783ebe20","s":"איך מקבלים מספר"},{"h":"2ac9bae04b7d834843c83b429b6ae6d6b8132287c0a5ffd330cef53b3ecede33","s":"משאירים פרטים, ואנחנו חוזרים באותו יום עם זמינות והצעה שמתאימה למה שסיפרתם. אם עוד לא קבעתם תאריך, אפשר לסמן את זה בטופס — זו שאלה לגיטימית לשאול לפני שסוגרים אולם."},{"h":"732f66e1f0601cf9eecb47b62aebfceb1c0eec31ac46b5d1c50ef3151ab77672","s":"לגלריה"},{"h":"d9003811c49e0f193e637c72a94118395001f6f300307f6b45716cd1bd79daf9","s":"רוצים את המספר שלכם?"},{"h":"272a7cd2d7b4b8305ddfc5e6ee72108ab5ebfd68115b0fa2f1265d55a02712b7","s":"ספרו לנו על האירוע ונחזור אליכם היום עם זמינות והצעה מותאמת. אין התחייבות ואין מכירה בטלפון."},{"h":"e56d15c5e409a1f61383e8aaa0a08a1e2bc13e5b4dce094c167c9726e5a83dd3","s":"שם מלא"},{"h":"88997e9b1817e15df10d043e3583f28b07af39b789705d706a3f4cb919a2078c","s":"(חובה)"},{"h":"4e443bc9b77afbb68ae00193404442dd0b16645a0bc73d270c82877f8d0155cc","s":"טלפון"},{"h":"5bc9932b8d149e9dda5374b8a7fa57a2e783ddcdc11816c404fd907493121e08","s":"אימייל"},{"h":"1aa122898c46b94168d5c6e41b2f502fa441fbf6ee24a59608a66c1d052759bf","s":"(אופציונלי — כדי לשלוח הצעה וגלריות)"},{"h":"aa546848158170c4565d6f9b122ea6eff2c27fcb4fc0035f1ac734ed9b218a11","s":"תאריך האירוע"},{"h":"6c49e74d8400135c4b8d9de03eda513326e0dcc5e