# Netlify / Cloudflare Pages header rules.
#
# THE LIVE HOST IS VERCEL, which reads vercel.json and IGNORES this file — so
# nothing here is in force today. It exists only so the site stays portable: if
# it is ever moved to Netlify or Cloudflare Pages, this file becomes the live
# policy. It used to carry a MINIMAL subset (no CSP, no HSTS), which meant a
# host migration would silently strip the entire security posture. It now
# mirrors vercel.json so the floor is the same wherever the site lands. When you
# change a security header in vercel.json, change it here in the same commit —
# tools/check.sh asserts this file still carries CSP and HSTS.
#
# Filenames are not fingerprinted, so HTML must always revalidate while
# immutable assets can be cached hard.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), browsing-topics=(), join-ad-interest-group=(), run-ad-auction=(), attribution-reporting=(), shared-storage=(), shared-storage-select-url=(), private-aggregation=(), interest-cohort=(), private-state-token-issuance=(), private-state-token-redemption=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw=' 'sha256-Ym/NdAkFIyLGKNh9VkD9I8GuyXFiVAiUHhZylu9H/UY=' 'sha256-PO5uvoWdZ+s5u7bahSbH3kXaEoYQljr/t56dOc1ghvc=' 'sha256-oehzWXgIg7kkj2Yg4YJ0hyrD4a2tiSO9d9ydsmzBqrQ='; connect-src 'self' https://dkejuaildigikufrdiru.supabase.co; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com; media-src 'self'; worker-src 'self' blob:; manifest-src 'self'

# The private CRM: stricter policy, never cached, never indexed. Mirrors the
# /admin.html block in vercel.json.
/admin.html
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://dkejuaildigikufrdiru.supabase.co; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=2592000

/assets/video/*
  Cache-Control: public, max-age=2592000

/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable
